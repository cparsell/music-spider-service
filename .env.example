# This is used for development purposes, but you can use it to set your own environment variables for the app. 

# To use it, copy this file to .env.local then fill in real values.
#
# Everything here is a *fallback* - lib/settings.js only reads these when the
# corresponding field in the Settings tab (persisted to data/settings.json)
# is blank. A saved setting always wins over the env var.

# --- Server ---
# Port the standalone server listens on (Dockerfile hardcodes 6100 via ENV).
PORT=6100
# Where settings.json / top-artists-cache.json are read/written.
# Defaults to ./data if unset.
DATA_DIR=./data

# --- Tautulli (top-artists source) ---
TAUTULLI_URL=http://your-tautulli-host:8181
TAUTULLI_API_KEY=
TAUTULLI_MUSIC_SECTION_ID=

# --- Spotify (top-artists source + OAuth, PKCE - no client secret needed) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:6100/api/spotify/callback

# --- Ticketmaster (event search) ---
TICKETMASTER_API_KEY=
LAT_LONG=37.8715226,-122.2730420
RADIUS=30
UNITS=miles

# --- Resident Advisor (event search) ---
RA_REGION=

# --- Weekly email digest ---
EMAIL_RECIPIENT=

# --- Google Calendar sync ---
CALENDAR_ID=
# OAuth - requires HTTPS on the redirect URI once accessed from anywhere
# other than 127.0.0.1/localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:6100/api/google/callback

# GCP service account (calendar only) -
# Provide either:
# - the JSON key file's contents, or
# - the path to the key file if you'd rather mount it.
# Enable it in Settings under
# Notification > Google Calendar (Service Account). The calendar must be
# shared with the service account's email address, and its ID set below
# (blank/primary would write to the service account's own calendar).
# See Setup-GoogleCalendarAccess.md.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_CALENDAR_ID=

# --- CalDAV calendar sync (independent of Google above - any CalDAV server:
# Nextcloud, Radicale, Baikal, iCloud, Fastmail, etc). CALDAV_URL is the
# specific calendar's collection URL, not just the server root. Enable it
# in Settings under Notification > CalDAV (Calendar). ---
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# --- Weekly webhook digest (Discord, Home Assistant, etc.) ---
WEBHOOK_URL=
